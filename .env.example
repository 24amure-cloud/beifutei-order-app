# コピーして .env にリネームして使う（.env は Git に含めない）
#
# Vercel の「名前」は英字・数字・アンダースコアのみ（ハイフン不可）。次のどれか1組でよい（vite.config.js がビルド時に VITE_* に流し込む）:
#   VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY   … おすすめ
#   SUPABASE_URL + SUPABASE_ANON_KEY
#   SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_URL + SUPABASE_KEY   … ドキュメントの旧例用（値は publishable / anon のみ。service_role は禁止）
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel の Supabase 連携だけ付いている場合、SUPABASE_URL / SUPABASE_ANON_KEY からもビルド時に取り込みます（vite.config.js）。
# 任意: テイクアウトスイーツ在庫 JSON の URL
# VITE_SWEETS_INVENTORY_URL=

# 任意: 客席（index）の無操作スクリーンセーバー
# ・カートに「注文確定できる商品」が1つでも入っている間は出ません（注文優先）。
# ・長尺・400MB級は Git/初回が重いので、短く圧縮した mp4 か CDN の URL を推奨。
# VITE_GUEST_IDLE_SCREENSAVER_MS=120000
# VITE_GUEST_PROMO_MEDIA=/promo-thumb.jpg,/videos/promo-short.mp4
# VITE_GUEST_PROMO_POSTER=/promo-thumb.jpg
# VITE_GUEST_PROMO_SLIDE_MS=8000
